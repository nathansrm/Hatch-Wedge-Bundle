# Environment template (development)
#
# Copy to `.env.local` and fill secrets. Never commit `.env.local`.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SIGNIN_ENABLED=false

# Database / auth
DATABASE_URL=
AUTH_SECRET=
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPER_ADMIN_EMAILS=

# Cron protection
CRON_USERNAME=
CRON_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paddle (sandbox vs production aligns with Paddle dashboard + NODE_ENV in server SDK client)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CREDITS_PRODUCT_ID=

# Polar
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_CREDITS_PRODUCT_ID=

# Dodo Payments
DODO_PAYMENTS_API_URL=https://api.dodopayments.com
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_CREDITS_PRODUCT_ID=

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_IS_SANDBOX=true

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_TEST_MODE=true

# S3 uploads
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Docker / Next standalone (production image)
# DOCKER_BUILD=true
